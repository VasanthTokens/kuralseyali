# Twilio (WhatsApp Business API sandbox — free)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Gemini API (free tier — handles both voice transcription AND text extraction)
GEMINI_API_KEY=your_gemini_api_key

# Google Sheets (free — used as the database instead of Firestore, no billing needed)
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json
GOOGLE_SHEET_ID=your_google_sheet_id

# Server
PORT=3000
TECHNICIAN_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX
